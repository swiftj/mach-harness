{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mach:schema:delivery-wave:v1",
  "title": "MACH Product Delivery Wave v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wave_id", "project_id", "revision", "base_project_revision", "status", "slices", "approval"],
  "properties": {
    "schema_version": {"const": 1},
    "wave_id": {"type": "string", "pattern": "^WAVE-[0-9]{3,}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "base_project_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved_for_engineering", "superseded"]},
    "slices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SLICE-[0-9]{3,}$"}},
    "approval": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["actor", "approved_at"],
         "properties": {
           "actor": {"type": "string", "minLength": 1},
           "approved_at": {"type": "string", "format": "date-time"}
         }}
      ]
    }
  }
}
