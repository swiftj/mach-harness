{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mach:schema:slice:v1",
  "title": "MACH Product Slice Work Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slice_id", "project_id", "epic_id", "revision", "title", "status", "dependencies", "open_questions", "spec_path", "spec_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "slice_id": {"type": "string", "pattern": "^SLICE-[0-9]{3,}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "epic_id": {"type": "string", "pattern": "^EPIC-[0-9]{3,}$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "interviewing", "ready_for_approval", "approved_for_engineering", "superseded"]},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SLICE-[0-9]{3,}$"}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "spec_path": {"type": ["string", "null"]},
    "spec_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "tracking": {
      "description": "Optional (M13 E): the Jira issue this belongs to. An identifier only; MACH never calls Jira.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jira"],
      "properties": {"jira": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[1-9][0-9]{0,8}$"}}
    },
    "mocks": {
      "description": "Optional (M14 C): the slice's design mocks, approved pictures by SHA-256, in SHA-256 order. The pictures are files beside the work order (product/mocks/SLICE-NNN/ in the workspace), never in this record.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "format", "width", "height", "bytes", "for", "binding", "note"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "format": {"enum": ["png", "jpeg"]},
          "width": {"type": "integer", "minimum": 1, "maximum": 10000},
          "height": {"type": "integer", "minimum": 1, "maximum": 10000},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 5242880},
          "for": {"type": ["string", "null"], "pattern": "^AC-[0-9]{2,}$", "description": "The scenario it shows; null for the slice as a whole."},
          "binding": {"type": "boolean", "description": "True only with a scenario: the built screen must match it, or verification fails."},
          "note": {"type": ["string", "null"], "maxLength": 200}
        }
      }
    },
    "origin": {
      "description": "Optional (M8): the request a slice came from. Identifiers only; never the issue's text, link or author.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "number"],
      "properties": {
        "kind": {"const": "github_issue"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"},
        "number": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "description": "Optional (M13 D): the PRD a slice was made from by prd apply. Identifiers and numbers only; never the document's text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prd_id", "sha256", "lines", "map_slice"],
      "properties": {
        "kind": {"const": "prd"},
        "prd_id": {"type": "string", "pattern": "^PRD-[0-9]{2,}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "lines": {"type": "array", "minItems": 1, "maxItems": 200,
                  "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}},
        "map_slice": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,31}$"}
      }
    },
    "serves": {
      "description": "Optional (M16 B): the idea and its brief's outcomes a draft slice made by Shape's idea apply serves. Identifiers only; never the brief. The slice's why names them in its header ('- **Serves:** IDEA-NNN O-1, O-2'), and the Factory's spec header line carries them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["idea", "outcomes"],
      "properties": {
        "idea": {"type": "string", "pattern": "^IDEA-[0-9]{3,}$"},
        "outcomes": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^O-[1-9][0-9]{0,3}$"}}
      }
    },
    "kind": {
      "description": "Optional (M18): 'small' for a slice started as a small change; always with 'small'. Absent for every other slice.",
      "const": "small"
    },
    "small": {
      "description": "Optional (M18): what a small change changes. A fix names the shipped rule that is not holding; an adjustment names none.",
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "shipped_rule"],
      "properties": {
        "change": {"enum": ["fix", "adjustment"]},
        "shipped_rule": {"type": ["string", "null"], "pattern": "^SLICE-[0-9]{3,}/(?:(?:INV|FR)-[0-9]{2,}|R[0-9]+)$"}
      }
    },
    "widened": {
      "description": "Optional (M18): when a small change left the light path. 'rule' is the small.py rule code that decided, or null on the product manager's word; 'reason' is that rule's fixed sentence or their words. A full slice from then on.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "reason", "rule"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "rule": {"type": ["string", "null"], "pattern": "^[a-z]+(?:-[a-z]+)*$"}
      }
    }
  }
}
