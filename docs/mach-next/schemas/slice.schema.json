{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mach:schema:slice:v1",
  "title": "MACH Product Slice Work Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slice_id", "project_id", "epic_id", "revision", "title", "status", "dependencies", "open_questions", "spec_path", "spec_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "slice_id": {"type": "string", "pattern": "^SLICE-[0-9]{3,}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "epic_id": {"type": "string", "pattern": "^EPIC-[0-9]{3,}$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "interviewing", "ready_for_approval", "approved_for_engineering", "superseded"]},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SLICE-[0-9]{3,}$"}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "spec_path": {"type": ["string", "null"]},
    "spec_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "tracking": {
      "description": "Optional (M13 E): the Jira issue this belongs to. An identifier only; MACH never calls Jira.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jira"],
      "properties": {"jira": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[1-9][0-9]{0,8}$"}}
    },
    "origin": {
      "description": "Optional (M8): the request a slice came from. Identifiers only; never the issue's text, link or author.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "number"],
      "properties": {
        "kind": {"const": "github_issue"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"},
        "number": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "description": "Optional (M13 D): the PRD a slice was made from by prd apply. Identifiers and numbers only; never the document's text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prd_id", "sha256", "lines", "map_slice"],
      "properties": {
        "kind": {"const": "prd"},
        "prd_id": {"type": "string", "pattern": "^PRD-[0-9]{2,}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "lines": {"type": "array", "minItems": 1, "maxItems": 200,
                  "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}},
        "map_slice": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,31}$"}
      }
    }
  }
}
