{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mach:schema:project:v1",
  "title": "MACH Product Project v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "revision", "status", "vision", "outcomes"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "name": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "active", "archived"]},
    "vision": {"type": "string", "minLength": 1},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
