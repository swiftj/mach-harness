{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mach:schema:epic:v1",
  "title": "MACH Product Epic v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "epic_id", "project_id", "revision", "title", "status", "acceptance_criteria"],
  "properties": {
    "schema_version": {"const": 1},
    "epic_id": {"type": "string", "pattern": "^EPIC-[0-9]{3,}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "deferred"]},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tracking": {
      "description": "Optional (M13 E): the Jira issue this belongs to. An identifier only; MACH never calls Jira.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jira"],
      "properties": {"jira": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[1-9][0-9]{0,8}$"}}
    },
    "serves": {
      "description": "Optional (M16 B): the idea and its brief's outcomes an epic made by Shape's idea apply serves. Identifiers only; never the brief.",
      "type": "object",
      "additionalProperties": false,
      "required": ["idea", "outcomes"],
      "properties": {
        "idea": {"type": "string", "pattern": "^IDEA-[0-9]{3,}$"},
        "outcomes": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^O-[1-9][0-9]{0,3}$"}}
      }
    }
  }
}
