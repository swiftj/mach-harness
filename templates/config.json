{
  "version": 1,
  "app_type": null,
  "tickets": {
    "provider": "local",
    "local_prefix": "LOCAL"
  },
  "telemetry": {
    "provider": null
  },
  "models": {
    "planning": "fable",
    "contracts": "opus",
    "build": "sonnet",
    "utility": "haiku"
  },
  "review": {
    "max_loops": 3,
    "security_exception_by": [],
    "high": { "approvals": 3, "reviewers": 3, "human_approval": true },
    "medium": { "approvals": 2, "reviewers": 3, "human_approval": false },
    "low": { "approvals": 1, "reviewers": 1, "human_approval": false }
  },
  "security": {
    "scan": { "enabled": true }
  },
  "audit": {
    "gold": 90,
    "silver": 70
  },
  "build": {
    "update_from_main": true
  },
  "merge": {
    "mode": "auto",
    "method": "local",
    "auto": { "low": true, "medium": true, "high": true },
    "pr": { "inline_findings": true }
  },
  "observe": {
    "every": 5
  },
  "adr": {
    "dir": "docs/adr",
    "landing": "pull-request",
    "required_topics": ["language", "framework", "storage", "testing", "deployment", "coding-standards"]
  },
  "factory": {
    "max_parallel": 3,
    "max_parallel_high": 1
  },
  "git": {
    "auto_commit": true
  }
}
