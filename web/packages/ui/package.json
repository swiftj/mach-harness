{
  "name": "@mach/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MACH design system: tokens, themes, primitives, shell, lifecycle visuals, graph foundation and API-client conventions. Shared by Product Studio and Control Tower.",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./graph": "./src/graph/index.ts",
    "./tokens": "./src/tokens/tokens.ts",
    "./styles.css": "./src/styles/index.css",
    "./graph.css": "./src/graph/graph.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "node scripts/tokens.ts --check && tsc -p tsconfig.json",
    "tokens": "node scripts/tokens.ts --write"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elkjs": "0.12.1",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
