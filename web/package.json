{
  "name": "mach-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "dev:showcase": "pnpm --filter @mach/showcase dev",
    "dev:studio": "pnpm --filter @mach/product-studio dev",
    "dev:studio:fixtures": "pnpm --filter @mach/product-studio dev:fixtures",
    "capture": "pnpm --filter @mach/showcase capture",
    "contrast": "node packages/ui/scripts/tokens.ts --report"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
